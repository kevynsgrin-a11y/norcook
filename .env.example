# Keep optional processing off until the legal operator, jurisdiction,
# privacy contact, and provider terms are published.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_NEWSLETTER_ENABLED=false

# Server-only. Configure only with an approved newsletter provider webhook.
#
# NEXT_PUBLIC_NEWSLETTER_ENABLED=true REQUIRES this to be set. The public flag
# only decides whether the form renders; the webhook decides whether the route
# can do anything. Setting the flag alone ships a live-looking form that answers
# 503 on every submission. See docs/newsletter-api.md.
NEWSLETTER_WEBHOOK_URL=
